# Copy this file to .env, then replace every change-me value before startup.
TZ=Asia/Shanghai
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
INFRA_BIND_ADDRESS=127.0.0.1
SECURITY_JWT_SECRET=change-me-jwt-secret-at-least-32-characters
SECURITY_JWT_TTL_SECONDS=86400
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,tauri://localhost,http://tauri.localhost

MYSQL_VERSION=8.4
MYSQL_PORT=3306
MYSQL_DATABASE=http_reading
MYSQL_USER=reading_assistant
MYSQL_PASSWORD=change-me-mysql-password
MYSQL_ROOT_PASSWORD=change-me-mysql-root-password
MYSQL_SERVER_TIMEZONE=Asia/Shanghai

REDIS_VERSION=7.4-alpine
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password

ELASTICSEARCH_VERSION=8.13.4
ELASTICSEARCH_IK_VERSION=8.13.4
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

RABBITMQ_VERSION=3.13-management-alpine
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=reading_assistant
RABBITMQ_PASSWORD=change-me-rabbitmq-password

QDRANT_VERSION=v1.12.5
QDRANT_PORT=6333
QDRANT_API_KEY=change-me-qdrant-api-key

# Optional model and integration credentials.
DEEPSEEK_API_KEY=
MODEL_API_KEY=
EMBEDDING_API_KEY=
GITHUB_TOKEN=
